# SealShip Environment Configuration

# Optional: Add your Gemini API Key for dynamic LLM risk analysis
# If left blank, SealShip uses the built-in deterministic rule-based security engine
GEMINI_API_KEY=""

# Minimum Trust Score required for pipeline approval (0-100)
TRUST_THRESHOLD="60"

# Target local Kubernetes registry
LOCAL_REGISTRY="localhost:5001"

# Backend API endpoint
BACKEND_URL="http://localhost:8000"

# Target Kubernetes namespace
SEALSHIP_NAMESPACE="sealship-demo"
